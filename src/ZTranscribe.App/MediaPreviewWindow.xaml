<Window x:Class="ZTranscribe.App.MediaPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Z Scribe · Media preview" Icon="Assets/z-transcribe.ico" Width="980" Height="680"
        MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MediaNameText" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MediaPathText" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" MinWidth="640" MinHeight="360" Background="#000000" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <vlc:VideoView MediaPlayer="{Binding Player.MediaPlayer}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <TextBlock x:Name="PlaybackErrorText" Visibility="Collapsed" Foreground="#FFFFFF" Background="#CC000000"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="620" Padding="18,12"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="▶" ToolTip="Play" Width="30" Height="30" Padding="0" Margin="0" Click="Play_Click"/>
                <Button Grid.Column="1" Content="Ⅱ" ToolTip="Pause" Width="30" Height="30" Padding="0" Margin="0" Click="Pause_Click"/>
                <TextBlock Grid.Column="2" x:Name="PositionText" Text="00:00" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Slider Grid.Column="3" x:Name="TimelineSlider" Minimum="0" Maximum="1" ValueChanged="TimelineSlider_ValueChanged"
                        IsMoveToPointEnabled="True" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="DurationText" Text="00:00" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0" ToolTip="Playback speed">
                    <RadioButton Content="1x" Tag="1" GroupName="PreviewPlaybackRate" IsChecked="True"
                                 Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                    <RadioButton Content="1.5x" Tag="1.5" GroupName="PreviewPlaybackRate"
                                 Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                    <RadioButton Content="2x" Tag="2" GroupName="PreviewPlaybackRate"
                                 Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                    <RadioButton Content="4x" Tag="4" GroupName="PreviewPlaybackRate"
                                 Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
