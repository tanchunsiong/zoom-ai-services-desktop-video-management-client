<Window x:Class="ZTranscribe.App.FloatingCaptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Live Captions"
        Width="760" Height="250" MinWidth="360" MinHeight="150"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        Background="#090909" Foreground="#FFFDF8">
    <Grid Background="#090909" AutomationProperties.Name="Floating live captions">
        <Grid Margin="18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="Text size" Foreground="#BFCDF5"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Right" Foreground="#BFCDF5" VerticalAlignment="Center"
                           Text="{Binding FloatingCaptionTextSize, StringFormat={}{0:0} pt}"/>
                <Slider Minimum="14" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding FloatingCaptionTextSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalAlignment="Center" AutomationProperties.Name="Floating caption text size"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FloatingCaptionEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Text}" Foreground="#FFFDF8"
                                           TextWrapping="Wrap" TextAlignment="Left" FontWeight="SemiBold"
                                           FontSize="{Binding DataContext.FloatingCaptionTextSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                <TextBlock Text="{Binding Translation}" Foreground="#BFCDF5"
                                           TextWrapping="Wrap" TextAlignment="Left" Margin="0,2,0,0"
                                           FontSize="{Binding DataContext.FloatingTranslationTextSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           Visibility="{Binding HasTranslation, Converter={StaticResource BooleanToVisibility}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
