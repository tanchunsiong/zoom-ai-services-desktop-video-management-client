<Window x:Class="ZTranscribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Z Scribe" Icon="Assets/z-transcribe.ico" Width="1420" Height="880" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Ink}" BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="258"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" Background="{StaticResource Accent}">
                        <Grid>
                            <Rectangle Width="18" Height="18" Fill="{StaticResource Yellow}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Ellipse Width="18" Height="18" Fill="{StaticResource Blue}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Path Data="M 9,10 L 32,10 L 10,32 L 33,32" Stroke="{StaticResource TextOnDark}" StrokeThickness="3.5"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Z SCRIBE" Foreground="{StaticResource TextOnDark}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="MEDIA INTELLIGENCE / 01" Foreground="{StaticResource TextOnDarkMuted}" FontFamily="{StaticResource BodyFont}" FontSize="9" FontWeight="SemiBold"
                                   Margin="1,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" BorderBrush="#353531" BorderThickness="1,0,1,0" Padding="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderPrimaryButton}" Click="AddFiles_Click" ToolTip="Add media files">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Add files" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Click="AddFolder_Click" ToolTip="Add a folder recursively">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Add folder" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Click="StartAll_Click" IsEnabled="{Binding IsQueueIdle}" ToolTip="Start all queued jobs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Start all" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" Click="PauseResume_Click" IsEnabled="{Binding IsQueueRunning}" ToolTip="Pause or resume the queue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PauseResumeLabel}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,8,0"/>
                    <TextBlock Text="LOCAL MEDIA / AUDIO ONLY" Foreground="{StaticResource TextOnDarkMuted}" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="ShellTabs" Grid.Row="1" TabStripPlacement="Left" Background="{StaticResource Surface}" BorderThickness="0">
            <TabItem Header="▤  Queue">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="QUEUE" Foreground="{StaticResource Accent}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Transcription queue" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock Text="Per-file transcription and translation routes" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding QueueCountLabel}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding QueueDurationLabel}" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="All" Style="{StaticResource QueueFilterButton}"
                                        Tag="{Binding IsAllQueueFilter}" Click="FilterAll_Click"/>
                                <Button Content="{Binding UnknownDurationFilterLabel}" Style="{StaticResource QueueFilterButton}"
                                        Tag="{Binding IsUnknownDurationFilter}" IsEnabled="{Binding HasUnknownDurationJobs}"
                                        Click="FilterUnknownDuration_Click"/>
                                <Button Content="{Binding WithoutAudioFilterLabel}" Style="{StaticResource QueueFilterButton}"
                                        Tag="{Binding IsWithoutAudioFilter}" IsEnabled="{Binding HasWithoutAudioJobs}"
                                        Click="FilterWithoutAudio_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastAddedCountLabel}" Foreground="{StaticResource Accent}" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,20,0,14" Padding="12" Background="{StaticResource BlueSoft}" BorderBrush="{StaticResource Blue}" BorderThickness="1" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" Background="{StaticResource Blue}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{StaticResource TextOnDark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AUDIO NORMALIZATION" FontFamily="{StaticResource DisplayFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Blue}"/>
                                <TextBlock Text="FFmpeg copies compatible mono/stereo streams; incompatible or multi-channel audio is decoded and downmixed to Zoom-compatible PCM WAV. Video is never uploaded."
                                           Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="JobsGrid" Grid.Row="2" ItemsSource="{Binding JobsView}" SelectedItem="{Binding SelectedJob}" Loaded="JobsGrid_Loaded"
                              IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" MouseDoubleClick="JobsGrid_DoubleClick"
                              PreviewMouseRightButtonDown="JobsGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Preview media" Click="PreviewJobMenuItem_Click"/>
                                <MenuItem Header="Review" Click="ReviewJobMenuItem_Click"
                                          Visibility="{Binding PlacementTarget.SelectedItem.CanReview, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}"/>
                                <MenuItem Header="Remove selected" Click="RemoveJobMenuItem_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Media" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MediaGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding SourcePath}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Spoken language" Width="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="34" VerticalAlignment="Center" Margin="4,2" ItemsSource="{Binding DataContext.SourceLanguages, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Locale"
                                                  SelectedValue="{Binding SourceLanguage, Mode=OneWay}"
                                                  IsEnabled="{Binding CanConfigureSourceLanguage}" Tag="source"
                                                  SelectionChanged="JobLanguage_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Translation" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="34" VerticalAlignment="Center" Margin="4,2" ItemsSource="{Binding DataContext.TranslationLanguages, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Locale"
                                                  SelectedValue="{Binding TranslationLanguage, Mode=OneWay}"
                                                  IsEnabled="{Binding CanConfigureLanguages}" Tag="translation"
                                                  SelectionChanged="JobLanguage_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Summary" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="34" VerticalAlignment="Center" Margin="4,2" ItemsSource="{Binding DataContext.SummaryOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Enabled"
                                                  SelectedValue="{Binding Summarize, Mode=OneWay}"
                                                  IsEnabled="{Binding CanConfigureLanguages}"
                                                  SelectionChanged="JobSummary_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Stage" Width="108">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center" ToolTip="{Binding StatusMessage}">
                                            <Border Width="24" Height="24" Background="{StaticResource BlueSoft}">
                                                <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="{StaticResource Blue}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding State}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Progress" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <ProgressBar Height="7" Value="{Binding Progress}" Maximum="100" Background="#D7D2C8" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Right" Margin="0,-19,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Update" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,3">
                                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding MediaProbeError}" TextWrapping="Wrap" Foreground="#8A6500" Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MediaProbeError}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationLabel}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                        <Setter Property="ToolTip" Value="{Binding DurationStatusLabel}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Estimate (USD)" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4" ToolTip="Rough before transcription; recalculated from transcript length after Scribe completes.">
                                            <TextBlock Text="{Binding EstimateQualityLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding EstimatedScribeCostLabel, StringFormat=Scribe  {0}}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding EstimatedTranslateCostLabel, StringFormat=Translate  {0}}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding EstimatedSummaryCostLabel, StringFormat=Summary  {0}}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding EstimatedTotalCostLabel, StringFormat=Total  {0}}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actual (USD)" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4" ToolTip="Measured Zoom usage at the rates configured in Settings.">
                                            <TextBlock Text="Actual" FontSize="10" FontWeight="SemiBold" Foreground="#58D6A8" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ActualScribeCostLabel, StringFormat=Scribe  {0}}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding ActualTranslateCostLabel, StringFormat=Translate  {0}}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding ActualSummaryCostLabel, StringFormat=Summary  {0}}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding ActualTotalCostLabel, StringFormat=Total  {0}}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <Button Content="Start current" Padding="8,4" Margin="0" Click="StartCurrent_Click"
                                                    Visibility="{Binding CanStart, Converter={StaticResource BooleanToVisibility}}"/>
                                            <Button Content="End current" Padding="8,4" Margin="0" Click="EndCurrent_Click"
                                                    Visibility="{Binding CanEnd, Converter={StaticResource BooleanToVisibility}}"/>
                                            <Button Content="Retry" Padding="8,4" Margin="0" Click="RetryCurrent_Click"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibility}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Preview selected" Click="PreviewSelected_Click"/>
                        <Button Content="Review selected" Click="Review_Click"/>
                        <Button Content="Translate selected" Click="TranslateSelected_Click"/>
                        <Button Content="Summarize selected" Click="SummarizeSelected_Click"/>
                        <Button Content="Open output folder" Click="OpenOutput_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="▶  Review">
                <Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="REVIEW" Foreground="{StaticResource Accent}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Review &amp; playback" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedJob.DisplayName, TargetNullValue=Double-click a completed queue item to begin.}" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Original captions" Click="OriginalCaptions_Click"/>
                            <Button Content="Translated captions" Click="TranslatedCaptions_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="420">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="460"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="76"/>
                                <RowDefinition Height="54"/>
                            </Grid.RowDefinitions>
                            <Border Background="#050505" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4,4,0,0" ClipToBounds="True">
                                <vlc:VideoView MediaPlayer="{Binding Player.MediaPlayer}"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                            <Border Grid.Row="1" Background="#000000" BorderBrush="{StaticResource Border}" BorderThickness="1,0,1,0" Padding="16,8">
                                <TextBlock Text="{Binding ActiveCaptionText}" Foreground="#FFFFFF" FontSize="18"
                                           TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="0,0,4,4" Padding="10,7">
                                <Grid IsEnabled="{Binding HasReviewMedia}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="▶" ToolTip="Play" Width="30" Height="30" Padding="0" Margin="0" Click="Play_Click"/>
                                    <Button Grid.Column="1" Content="Ⅱ" ToolTip="Pause" Width="30" Height="30" Padding="0" Margin="0" Click="PausePlayback_Click"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PlaybackPositionLabel}" Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Slider Grid.Column="3" Minimum="0" Maximum="{Binding PlaybackDurationSeconds}"
                                            Value="{Binding PlaybackPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsMoveToPointEnabled="True" Margin="8,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PlaybackDurationLabel}" Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0" ToolTip="Playback speed">
                                        <RadioButton Content="1x" Tag="1" GroupName="PlaybackRate" IsChecked="True"
                                                     Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                                        <RadioButton Content="1.5x" Tag="1.5" GroupName="PlaybackRate"
                                                     Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                                        <RadioButton Content="2x" Tag="2" GroupName="PlaybackRate"
                                                     Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                                        <RadioButton Content="4x" Tag="4" GroupName="PlaybackRate"
                                                     Style="{StaticResource PlaybackRateButton}" Click="PlaybackRate_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <GridSplitter Grid.Column="1" Width="8" Background="Transparent"/>
                        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4" Padding="10">
                            <TabControl Background="Transparent" BorderThickness="0">
                                <TabItem Header="Captions">
                                    <ListBox x:Name="CueList" ItemsSource="{Binding ReviewCues}" Background="Transparent" BorderThickness="0"
                                             PreviewMouseLeftButtonUp="CueList_PreviewMouseLeftButtonUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="7,11">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Start}" Foreground="#8D82FF" FontSize="12"/>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>
                                <TabItem Header="Summary">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" LineHeight="22"/>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="⚙  Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="32" MaxWidth="1040" HorizontalAlignment="Left">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="SETTINGS" Foreground="{StaticResource Accent}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,0"/>
                            <TextBlock Text="Credentials stay in Windows Credential Manager and are never written to logs or queue files." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,22,0,0" Padding="22" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Zoom Build credentials" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="API key" Foreground="{StaticResource TextMuted}" Margin="0,18,0,6"/>
                                <TextBox x:Name="ApiKeyBox" Text="{Binding ApiKey, Mode=OneWay}"/>
                                <TextBlock Text="API secret" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                                <PasswordBox x:Name="ApiSecretBox"/>
                                <TextBlock Text="Leave the secret blank to keep the currently saved credential." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Margin="0,16,0,0" Padding="22" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Media tools" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="FFmpeg executable" Foreground="{StaticResource TextMuted}" Margin="0,18,0,6"/>
                                <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="FFprobe executable" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding Settings.FfprobePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Parallel Scribe requests (1–4)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.ScribeConcurrency, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Segment minutes (1–30)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.SegmentMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="3" Margin="0,16,0,0" Padding="22" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Cost estimate rates (USD)" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Defaults use Zoom Build Platform Fast API rates. Override them if your account rates differ; zero is shown as unavailable, not free." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Scribe Fast USD / audio minute" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.ScribeUsdPerMinute, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Translator USD / 1M characters" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.TranslatorUsdPerMillionCharacters, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Summarizer USD / 1M characters" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.SummarizerUsdPerMillionCharacters, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Characters / minute override (0 = auto)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding Settings.EstimatedTranslationCharactersPerMinute, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Grid.Row="4" Content="Save settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,30" Click="SaveSettings_Click"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource Ink}" BorderBrush="{StaticResource Ink}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Notice}" Foreground="{StaticResource TextOnDarkMuted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,18,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            ToolTip="Estimated and measured USD using the rates in Settings. Text services use input plus output characters.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Grand estimate" Foreground="{StaticResource Yellow}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding EstimatedQueueScribeCostLabel, StringFormat=Scribe  {0}}" Foreground="{StaticResource TextOnDark}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding EstimatedQueueTranslateCostLabel, StringFormat=Translate  {0}}" Foreground="{StaticResource TextOnDark}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding EstimatedQueueSummaryCostLabel, StringFormat=Summary  {0}}" Foreground="{StaticResource TextOnDark}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding EstimatedQueueTotalCostLabel, StringFormat=Total  {0}}" Foreground="{StaticResource TextOnDark}" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Grand actual" Foreground="#73C79B" FontWeight="SemiBold" Margin="0,0,20,0"/>
                        <TextBlock Text="{Binding ActualQueueScribeCostLabel, StringFormat=Scribe  {0}}" Foreground="{StaticResource TextOnDark}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding ActualQueueTranslateCostLabel, StringFormat=Translate  {0}}" Foreground="{StaticResource TextOnDark}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding ActualQueueSummaryCostLabel, StringFormat=Summary  {0}}" Foreground="{StaticResource TextOnDark}" Margin="0,0,14,0"/>
                        <TextBlock Text="{Binding ActualQueueTotalCostLabel, StringFormat=Total  {0}}" Foreground="{StaticResource TextOnDark}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
