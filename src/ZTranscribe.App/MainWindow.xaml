<Window x:Class="ZTranscribe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Z Transcribe" Width="1420" Height="880" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Accent}">
                        <TextBlock Text="Z" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Z Transcribe" Margin="11,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ Add files" Style="{StaticResource PrimaryButton}" Click="AddFiles_Click"/>
                    <Button Content="Add folder" Click="AddFolder_Click"/>
                    <Button Content="Start queue" Click="StartQueue_Click"/>
                    <Button Content="Cancel current" Click="CancelQueue_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#2DD4A7" Margin="0,0,8,0"/>
                    <TextBlock Text="Audio-only upload · original audio" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="ShellTabs" Grid.Row="1" TabStripPlacement="Left" Background="{StaticResource Surface}" BorderThickness="0">
            <TabItem Header="▤  Queue">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Transcription queue" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Drop media here, choose a language route, then process in order." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Spoken language" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox Width="185" ItemsSource="{Binding SourceLanguages}" SelectedItem="{Binding SourceLanguage}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Optional translation" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                                <ComboBox Width="205" ItemsSource="{Binding TranslationLanguages}" SelectedItem="{Binding TranslationLanguage}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,20,0,14" Padding="14" Background="#18243A" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="FFmpeg copies the first audio stream into a Zoom-supported container. Video is never uploaded, and audio is not resampled or recompressed." Foreground="#C5D0E4"/>
                    </Border>
                    <DataGrid x:Name="JobsGrid" Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                              IsReadOnly="True" SelectionMode="Single" AlternationCount="2" MouseDoubleClick="JobsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Media" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="From" Binding="{Binding SourceLanguage}" Width="100"/>
                            <DataGridTextColumn Header="Translate" Binding="{Binding TranslationLanguage, TargetNullValue=—}" Width="100"/>
                            <DataGridTextColumn Header="Stage" Binding="{Binding State}" Width="110"/>
                            <DataGridTemplateColumn Header="Progress" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,6">
                                            <ProgressBar Height="7" Value="{Binding Progress}" Maximum="100" Background="#293550" Foreground="{StaticResource Accent}"/>
                                            <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" HorizontalAlignment="Right" Margin="0,-19,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Update" Binding="{Binding StatusMessage}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Review selected" Click="Review_Click"/>
                        <Button Content="Retry" Click="Retry_Click"/>
                        <Button Content="Remove" Click="Remove_Click"/>
                        <Button Content="Open output folder" Click="OpenOutput_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="▶  Review">
                <Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Review &amp; playback" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedJob.DisplayName, TargetNullValue=Double-click a completed queue item to begin.}" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="Original captions" Click="OriginalCaptions_Click"/>
                            <Button Content="Translated captions" Click="TranslatedCaptions_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <Border Background="#05070B" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <vlc:VideoView MediaPlayer="{Binding Player.MediaPlayer}"/>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="8" Background="Transparent"/>
                        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Caption timeline" FontWeight="SemiBold" Margin="7,5,0,12"/>
                                <ListBox x:Name="CueList" Grid.Row="1" ItemsSource="{Binding ReviewCues}" Background="Transparent" BorderThickness="0" MouseDoubleClick="CueList_DoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="7,11">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Start}" Foreground="#8D82FF" FontSize="12"/>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="⚙  Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="32" MaxWidth="820" HorizontalAlignment="Left">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Credentials stay in Windows Credential Manager and are never written to logs or queue files." Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,22,0,0" Padding="22" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Zoom Build credentials" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="API key" Foreground="{StaticResource TextMuted}" Margin="0,18,0,6"/>
                                <TextBox x:Name="ApiKeyBox" Text="{Binding ApiKey, Mode=OneWay}"/>
                                <TextBlock Text="API secret" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                                <PasswordBox x:Name="ApiSecretBox"/>
                                <TextBlock Text="Leave the secret blank to keep the currently saved credential." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Margin="0,16,0,0" Padding="22" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Media tools" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="FFmpeg executable" Foreground="{StaticResource TextMuted}" Margin="0,18,0,6"/>
                                <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="FFprobe executable" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding Settings.FfprobePath, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Output root (blank creates ‘Z Transcribe Outputs’ beside each source)" Foreground="{StaticResource TextMuted}" Margin="0,14,0,6"/>
                                <TextBox Text="{Binding Settings.OutputRoot, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Parallel Scribe requests (1–4)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.ScribeConcurrency, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Segment minutes (1–30)" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding Settings.SegmentMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Grid.Row="3" Content="Save settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,30" Click="SaveSettings_Click"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0B1220" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="22,0"/>
        </Border>
    </Grid>
</Window>
